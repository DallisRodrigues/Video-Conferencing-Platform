# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- MongoDB (required) -------------------------------------------------------
# Full connection string. It may already contain credentials
# (mongodb+srv://user:pass@cluster.example.mongodb.net/), which is the
# recommended form. Atlas' "<username>" / "<db_password>" placeholders are also
# accepted and filled from the two variables below.
MONGODB_URI=""
# Only used when MONGODB_URI has no credentials or uses placeholders.
# Values are URL-encoded automatically.
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
# Database name (the URI's path is ignored). Use a separate name for experiments.
MONGODB_DB_NAME="video_conferencing_platform"

# --- Server (optional) --------------------------------------------------------
# PORT=8000
# HOST=0.0.0.0
# NODE_ENV=development
# Comma-separated origins allowed to call the API cross-origin. Only needed when
# the frontend is hosted on a different origin (e.g. a separate Render Static Site).
# CLIENT_ORIGINS="https://your-frontend.onrender.com"
# MAX_PARTICIPANTS=6
# SESSION_TTL_DAYS=7
# Set to "false" to stop serving ../frontend/dist from this server.
# SERVE_FRONTEND=true

# --- WebRTC ICE servers (optional) -------------------------------------------
# STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# TURN relays calls between restrictive networks. Use ONE of:
#   a) coturn-style shared secret (short-lived credentials are minted per request)
# TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# TURN_SECRET=""
# TURN_TTL_SECONDS=3600
#   b) static credentials from a TURN provider
# TURN_USERNAME=""
# TURN_CREDENTIAL=""
